{
  "uid": "sentinel-slo",
  "title": "Sentinel / checkout-api SLO",
  "tags": [
    "sentinel",
    "slo"
  ],
  "timezone": "utc",
  "schemaVersion": 39,
  "refresh": "30s",
  "time": {
    "from": "now-3h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "current": {}
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Error budget remaining (30d) \u2014 availability",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.25
              },
              {
                "color": "green",
                "value": 0.5
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "slo:error_budget_remaining:ratio{service=\"checkout-api\",slo=\"availability\"}",
          "legendFormat": "{{slo}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Error budget remaining (30d) \u2014 latency",
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.25
              },
              {
                "color": "green",
                "value": 0.5
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "slo:error_budget_remaining:ratio{service=\"checkout-api\",slo=\"latency\"}",
          "legendFormat": "{{slo}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Burn rate (1h) \u2014 availability",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "x",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 2
              },
              {
                "color": "red",
                "value": 14.4
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "slo:burn_rate:ratio_rate1h{service=\"checkout-api\",slo=\"availability\"}",
          "legendFormat": "{{slo}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Burn rate (1h) \u2014 latency",
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "x",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 2
              },
              {
                "color": "red",
                "value": 14.4
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "slo:burn_rate:ratio_rate1h{service=\"checkout-api\",slo=\"latency\"}",
          "legendFormat": "{{slo}}"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "5xx ratio by version (canary vs stable)",
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 0.005
              }
            ]
          },
          "custom": {
            "thresholdsStyle": {
              "mode": "line"
            }
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (version) (rate(http_requests_total{service=\"checkout-api\",code=~\"5..\"}[1m])) / sum by (version) (rate(http_requests_total{service=\"checkout-api\"}[1m]))",
          "legendFormat": "{{version}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "p99 latency by version",
      "gridPos": {
        "x": 12,
        "y": 5,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 0.3
              }
            ]
          },
          "custom": {
            "thresholdsStyle": {
              "mode": "line"
            }
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.99, sum by (version, le) (rate(http_request_duration_seconds_bucket{service=\"checkout-api\"}[1m])))",
          "legendFormat": "{{version}}"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Request rate by version",
      "gridPos": {
        "x": 0,
        "y": 13,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (version) (rate(http_requests_total{service=\"checkout-api\"}[1m]))",
          "legendFormat": "{{version}}"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Multi-window burn rates \u2014 availability",
      "gridPos": {
        "x": 12,
        "y": 13,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "x",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 6
              },
              {
                "color": "red",
                "value": 14.4
              }
            ]
          },
          "custom": {
            "thresholdsStyle": {
              "mode": "line"
            }
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "slo:sli_error:ratio_rate5m{service=\"checkout-api\",slo=\"availability\"} / 0.005",
          "legendFormat": "5m"
        },
        {
          "refId": "B",
          "expr": "slo:sli_error:ratio_rate30m{service=\"checkout-api\",slo=\"availability\"} / 0.005",
          "legendFormat": "30m"
        },
        {
          "refId": "C",
          "expr": "slo:sli_error:ratio_rate1h{service=\"checkout-api\",slo=\"availability\"} / 0.005",
          "legendFormat": "1h"
        },
        {
          "refId": "D",
          "expr": "slo:sli_error:ratio_rate6h{service=\"checkout-api\",slo=\"availability\"} / 0.005",
          "legendFormat": "6h"
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Rollout phase (1 = in phase)",
      "gridPos": {
        "x": 0,
        "y": 21,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (phase) (rollout_info{name=\"checkout-api\"})",
          "legendFormat": "{{phase}}"
        }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Incident copilot briefs",
      "gridPos": {
        "x": 12,
        "y": 21,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (alertname, brief_source) (increase(copilot_incidents_total[5m]))",
          "legendFormat": "{{alertname}} ({{brief_source}})"
        }
      ]
    }
  ]
}
